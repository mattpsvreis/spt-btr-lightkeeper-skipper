<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dark-BTRLightkeeperSkipper</AssemblyName>
    <RootNamespace>Dark.BTRLightkeeperSkipper.Server</RootNamespace>
    <Version>1.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <SptServerDir Condition=" '$(SptServerDir)' == '' ">D:\SPT\SPT_Runtime\</SptServerDir>
    <ServerModFolderName>Dark-BTRLightkeeperSkipper</ServerModFolderName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptServerDir)SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptServerDir)SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SptServerDir)SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptServerDir)SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptServerDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptServerDir)SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <MakeDir Directories="$(SptServerDir)user\mods\$(ServerModFolderName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptServerDir)user\mods\$(ServerModFolderName)\" />
  </Target>
</Project>
